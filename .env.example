GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

DATABASE_URL=sqlite:///./backend/signaflow.db
VECTOR_DB_PATH=./data/vector_db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

APP_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated hostnames explicitly approved for respectful public catalogue ingestion.
# Leave empty to disable live web ingestion and use the bundled fictional demo catalogue.
CATALOG_ALLOWED_HOSTS=

N8N_WEBHOOK_URL=
POSTGRES_PASSWORD=signaflow-local-only

DEMO_ADMIN_PASSWORD=demo123
DEMO_SALES_PASSWORD=demo123
DEMO_CUSTOMER_PASSWORD=demo123
